<Window x:Class="OddSnap.UI.SnippingResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OddSnap"
        Width="1100" Height="720"
        MinWidth="760" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        ShowInTaskbar="True"
        Background="#202020"
        KeyDown="Window_KeyDown">
    <Window.Resources>
        <Style x:Key="ToolbarButton" TargetType="Button">
            <Setter Property="Foreground" Value="#F4F4F4"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#343434"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#454545"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.42"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CaptionButton" TargetType="Button" BasedOn="{StaticResource ToolbarButton}">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="FontSize" Value="16"/>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#3A3A3A" BorderThickness="1" Background="#202020">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="46"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="#252525" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Style="{StaticResource ToolbarButton}" Click="NewScreenshot_Click" ToolTip="New screenshot">＋ Screenshot</Button>
                <Button Grid.Column="1" Style="{StaticResource ToolbarButton}" Click="NewRecording_Click" ToolTip="New screen recording">● Recording</Button>
                <Border Grid.Column="3" Background="#505050" Margin="0,10"/>
                <Button Grid.Column="5" x:Name="CopyButton" Style="{StaticResource ToolbarButton}" Click="Copy_Click" ToolTip="Copy">Copy</Button>
                <Button Grid.Column="6" Style="{StaticResource ToolbarButton}" Click="SaveAs_Click" ToolTip="Save as">Save as</Button>
                <Button Grid.Column="7" x:Name="OpenFolderButton" Style="{StaticResource ToolbarButton}" Click="OpenFolder_Click" ToolTip="Open file location">Open folder</Button>

                <TextBlock Grid.Column="8" x:Name="TitleText" Text="Capture result"
                           Foreground="#D8D8D8" FontSize="13" FontWeight="SemiBold"
                           VerticalAlignment="Center" HorizontalAlignment="Center"
                           TextTrimming="CharacterEllipsis" Margin="16,0"/>

                <Button Grid.Column="9" Style="{StaticResource CaptionButton}" Click="Minimize_Click" ToolTip="Minimize">—</Button>
                <Button Grid.Column="10" Style="{StaticResource CaptionButton}" Click="Maximize_Click" ToolTip="Maximize">□</Button>
                <Button Grid.Column="11" Style="{StaticResource CaptionButton}" Click="Close_Click" ToolTip="Close">×</Button>
            </Grid>

            <Grid Grid.Row="1" Background="#171717">
                <Image x:Name="ResultImage" Stretch="Uniform" Margin="18"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <MediaElement x:Name="ResultMedia" Visibility="Collapsed" Margin="18"
                              LoadedBehavior="Manual" UnloadedBehavior="Manual"
                              Stretch="Uniform" MediaOpened="ResultMedia_MediaOpened"
                              MediaEnded="ResultMedia_MediaEnded" MediaFailed="ResultMedia_MediaFailed"/>
                <TextBlock x:Name="EmptyMessage" Visibility="Collapsed"
                           Text="Preview is unavailable, but the file was saved."
                           Foreground="#B8B8B8" FontSize="16"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>

            <Grid Grid.Row="2" Background="#252525">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" x:Name="PlayPauseButton" Style="{StaticResource ToolbarButton}"
                        Click="PlayPause_Click" Visibility="Collapsed">Pause</Button>
                <Slider Grid.Column="1" x:Name="PositionSlider" Margin="10,0"
                        Minimum="0" Maximum="1" Value="0" VerticalAlignment="Center"
                        Visibility="Collapsed" PreviewMouseLeftButtonDown="PositionSlider_PreviewMouseLeftButtonDown"
                        PreviewMouseLeftButtonUp="PositionSlider_PreviewMouseLeftButtonUp"/>
                <TextBlock Grid.Column="2" x:Name="StatusText" Text="Ready"
                           Foreground="#BDBDBD" FontSize="12" VerticalAlignment="Center"
                           Margin="12,0,16,0"/>
            </Grid>
        </Grid>
    </Border>
</Window>
